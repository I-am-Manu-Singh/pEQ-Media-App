<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/peq_widget_bg_modern"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <!-- ================================================= -->
    <!-- ART -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/art_container"
        android:layout_width="112dp"
        android:layout_height="112dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/peq_album_art_shape_small"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music" />

    </FrameLayout>

    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Song Title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ================================================= -->
    <!-- ARTIST -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Artist"
        android:textColor="#FFD600"
        android:textSize="13sp" />

    <!-- ================================================= -->
    <!-- PROGRESS -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_current_time"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0:00"
            android:textColor="#FFD600"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/peq_widget_progress" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="4:20"
            android:textColor="#FFD600"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- ================================================= -->
    <!-- CONTROLS -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/peq_circle_button"
            android:padding="10dp"
            android:src="@drawable/ic_shuffle"
            android:tint="#FFD600" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/peq_circle_button"
            android:padding="10dp"
            android:src="@drawable/ic_previous"
            android:tint="#FFD600" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/peq_play_button"
            android:padding="16dp"
            android:src="@drawable/ic_play"
            android:tint="#000000" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/peq_circle_button"
            android:padding="10dp"
            android:src="@drawable/ic_next"
            android:tint="#FFD600" />

        <ImageButton
            android:id="@+id/widget_favorite"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/peq_circle_button"
            android:padding="10dp"
            android:src="@drawable/ic_favorite_outline"
            android:tint="#FFD600" />

    </LinearLayout>

</LinearLayout>