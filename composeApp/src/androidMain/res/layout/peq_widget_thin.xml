<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/peq_widget_bg_modern"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- ================================================= -->
    <!-- ART -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/art_container"
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/peq_album_art_shape_small"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music" />

    </FrameLayout>

    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Song"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- ================================================= -->
    <!-- ARTIST -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Artist"
        android:textColor="#FFD600"
        android:textSize="8sp" />

    <!-- ================================================= -->
    <!-- SPACER -->
    <!-- ================================================= -->

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ================================================= -->
    <!-- CONTROLS -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/peq_circle_button"
            android:padding="8dp"
            android:src="@drawable/ic_previous"
            android:tint="#FFD600" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/peq_play_button"
            android:padding="11dp"
            android:src="@drawable/ic_play"
            android:tint="#000000" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/peq_circle_button"
            android:padding="8dp"
            android:src="@drawable/ic_next"
            android:tint="#FFD600" />

    </LinearLayout>

</LinearLayout>